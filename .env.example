# Copy to .env and fill in. Everything has a working dev default except Stripe.

APP_NAME="SaaS Template"
ENVIRONMENT=development
# Leave the placeholder for local dev: it is never used to sign — a random
# per-checkout key is generated in backend/.dev-secrets/ instead. Any
# non-local deployment refuses to boot until this is a real secret.
SECRET_KEY=change-me-generate-a-long-random-string
# Key rotation: when you change SECRET_KEY, put the old value here so tokens
# signed with it keep verifying; clear it again after ~48h (longest token TTL).
SECRET_KEY_PREVIOUS=

# Stripe (test mode) — one-time credit packs (mode=payment) + community
# membership subscriptions (mode=subscription).
# Webhook secret comes from: stripe listen --forward-to localhost:21428/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time credit packs (one-off Prices, mode=payment) — empty disables a pack.
STRIPE_PRICE_CREDITS_STARTER=
STRIPE_PRICE_CREDITS_GROWTH=
STRIPE_PRICE_CREDITS_SCALE=
STRIPE_PRICE_CREDITS_BULK=
# Community membership plans (recurring Prices, mode=subscription) — empty
# disables a plan. Create via: python scripts/stripe_sync.py
STRIPE_PRICE_COMMUNITY_MONTHLY=
STRIPE_PRICE_COMMUNITY_ANNUAL=
# Organization plans (recurring Prices) — empty disables that plan/interval.
STRIPE_PRICE_PLAN_PRO_MONTHLY=
STRIPE_PRICE_PLAN_PRO_ANNUAL=
STRIPE_PRICE_PLAN_TEAM_MONTHLY=
STRIPE_PRICE_PLAN_TEAM_ANNUAL=

# AI providers (generations + llm) — an empty key disables that provider.
# GEMINI_API_KEY powers nano-banana images + VEO 3.1 video + Gemini text;
# OPENAI_API_KEY powers GPT images + GPT text; ANTHROPIC_API_KEY powers Claude text.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email — "smtp" routes everything to Mailpit (http://localhost:21431) in dev.
# Switch to "resend" to test the real provider locally (needs RESEND_* below).
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=
SUPPORT_EMAIL=

# Security policy (see docs/customization.md § Security) — safe defaults for new projects.
# DOMAIN_CLAIM_MODE=verified_claim|manual_only|off
DOMAIN_CLAIM_MODE=verified_claim
# EMAIL_VERIFICATION_GATE=sensitive|login|none
EMAIL_VERIFICATION_GATE=sensitive
# Verify-first signup: register always answers "check your email" (never
# reveals whether an address has an account) and sign-in works only after the
# emailed link is used. Off = one-step signup with auto sign-in (leaks account
# existence via 409, rate-limited). See docs/customization.md § Security.
SIGNUP_ENUMERATION_PROTECTION=false
# Login lockout (Redis-backed; in-memory fallback when Redis is down).
# MAX_ATTEMPTS failures from one IP within the window lock that email for
# that IP only (the owner on another IP is unaffected). ACCOUNT_MAX_ATTEMPTS
# failures across all IPs lock the email for everyone — the cap on
# distributed guessing; keep it well above MAX_ATTEMPTS, 0 disables.
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_ACCOUNT_MAX_ATTEMPTS=50
LOGIN_LOCKOUT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_DURATION_MINUTES=15
# Security-event trail (audit_events) retention — purged daily by a beat task.
AUDIT_RETENTION_DAYS=365

# Token / link lifetimes — the defaults below match backend/app/core/config.py.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_DAYS=7
IMPERSONATION_TTL_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60

# Text-completion model per provider (domains/llm) — override per project.
LLM_GEMINI_MODEL=gemini-2.5-flash
LLM_OPENAI_MODEL=gpt-4.1-mini
LLM_ANTHROPIC_MODEL=claude-sonnet-4-6

# Resend (only used when EMAIL_PROVIDER=resend) — see app/core/email/resend_provider.py
RESEND_API_KEY=
RESEND_SEGMENT_MARKETING=
RESEND_WEBHOOK_SECRET=

# Error tracking — leave empty to disable Sentry entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Object storage — local disk by default; "s3" requires bucket, region, and both keys.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
# Optional: empty uses AWS; DigitalOcean Spaces uses its regional endpoint URL.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
