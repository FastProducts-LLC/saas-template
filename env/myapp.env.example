# /opt/prd-shared/env/myapp.env — app secrets for the myapp overlay.
# Copy to env/myapp.env on the production droplet. chmod 600.
# Loaded by env_file in docker-compose.myapp.yml — keys are unprefixed.

# --- App ---
APP_NAME="SaaS Template"
SECRET_KEY=change-me-generate-a-long-random-string
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=["https://your-domain.com"]

# --- Managed services (NAMING.md: prd-myapp-db / prd-myapp-cache) ---
DATABASE_URL=postgresql+asyncpg://user:pass@prd-myapp-db-do-user-xxxxx.db.ondigitalocean.com:25060/myapp_prod
# Valkey DB allocation (must match backend/app/core/config.py):
#   /0 app cache · /1 celery broker · /2 celery results
REDIS_URL=rediss://default:pass@prd-myapp-cache-do-user-xxxxx.db.ondigitalocean.com:25061/0
# REQUIRED in prod: celery does NOT derive these from REDIS_URL — without
# them the workers/beat fall back to localhost and break.
CELERY_BROKER_URL=rediss://default:pass@prd-myapp-cache-do-user-xxxxx.db.ondigitalocean.com:25061/1
CELERY_RESULT_BACKEND=rediss://default:pass@prd-myapp-cache-do-user-xxxxx.db.ondigitalocean.com:25061/2

# --- Email ---
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@your-domain.com
EMAIL_FROM_NAME="SaaS Template"
SUPPORT_EMAIL=support@your-domain.com

# Security policy — see docs/customization.md § Security
DOMAIN_CLAIM_MODE=verified_claim
EMAIL_VERIFICATION_GATE=sensitive

RESEND_API_KEY=
RESEND_SEGMENT_MARKETING=
RESEND_WEBHOOK_SECRET=

# SMTP relay (only used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587

# --- Stripe (live mode; webhook → https://your-domain.com/api/billing/webhook) ---
# One-time credit packs (mode=payment) + community membership subscriptions
# (mode=subscription; empty price id disables that plan).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_STARTER=
STRIPE_PRICE_CREDITS_GROWTH=
STRIPE_PRICE_CREDITS_SCALE=
STRIPE_PRICE_CREDITS_BULK=
STRIPE_PRICE_COMMUNITY_MONTHLY=
STRIPE_PRICE_COMMUNITY_ANNUAL=
# Organization plans (recurring Prices) — empty disables that plan/interval.
STRIPE_PRICE_PLAN_PRO_MONTHLY=
STRIPE_PRICE_PLAN_PRO_ANNUAL=
STRIPE_PRICE_PLAN_TEAM_MONTHLY=
STRIPE_PRICE_PLAN_TEAM_ANNUAL=

# --- AI providers (empty key disables that provider) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Text-completion model per provider (domains/llm) — override per project.
LLM_GEMINI_MODEL=gemini-2.5-flash
LLM_OPENAI_MODEL=gpt-4.1-mini
LLM_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Error tracking (empty disables Sentry) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Object storage — local disk by default; "s3" requires bucket, region, and both keys.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
# Optional: empty uses AWS; DigitalOcean Spaces uses its regional endpoint URL.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
