# /opt/prd-shared/caddy.d/myapp.caddy
# Caddy vhost for myapp on the prd-shared-host droplet.
#
# Zero-downtime mechanics (start-first rollouts create a window where old and
# new containers coexist under the same service name):
#   - `dynamic a` re-resolves Docker DNS every 3s, so each container IP is a
#     separate upstream. NOTE: Caddy active health checks (health_uri) do NOT
#     run against dynamic upstreams — don't add them here, they'd be a no-op.
#   - `fail_duration` passively marks a dead IP down on first failed dial,
#     leaving the healthy IP in rotation.
#   - `lb_try_duration`/`lb_try_interval` retry in-flight requests that hit a
#     dying container, so users never see the cutover.

your-domain.com {
	import security_headers
	# Single source of truth for the CSP — set at the edge so it covers both
	# the SPA and /api/* responses (frontend/nginx.conf deliberately sets no
	# CSP: a second policy would intersect with this one in the browser).
	#   - googletagmanager/google-analytics hosts serve the consent-gated GA
	#     loader (frontend/src/shared/lib/analytics.ts) — remove them if you
	#     don't set VITE_GA_MEASUREMENT_ID.
	#   - Sentry hosts must stay in sync with frontend/src/shared/lib/sentry.ts.
	#   - Stripe needs no allowance (hosted Checkout via top-level redirect).
	#   - The Vite dev server sends no CSP; this policy is prod-only.
	header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com; connect-src 'self' https://*.ingest.sentry.io https://*.sentry.io https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	encode gzip zstd

	handle /api/* {
		reverse_proxy {
			dynamic a myapp-backend 8000 {
				refresh 3s
			}

			fail_duration 10s
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy {
			dynamic a myapp-frontend 8080 {
				refresh 3s
			}

			fail_duration 10s
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}

www.your-domain.com {
	redir https://your-domain.com{uri} permanent
}
